# Q-FLOW Supabase Configuration Template
# Copy this file to .env or .env.local to connect to your live Supabase project

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (safe for frontend use)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# IMPORTANT:
# - Do NOT place your Supabase service_role key here.
# - The Anon key is safe for frontend code because authorization is enforced by PostgreSQL RLS.
