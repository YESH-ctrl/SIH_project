# Q-FLOW Frontend environment configuration
# Copy to .env and fill in. NEVER put service-role keys here.

# Backend REST API base (Vite dev proxy serves /api -> localhost:8000)
VITE_API_BASE_URL=/api/v1

# Realtime WebSocket (defaults to same host as the page)
# Production example: wss://api.your-domain.com
VITE_WS_BASE_URL=

# Supabase (browser anon key ONLY — never the service-role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
