# =============================================================
# Q-FLOW Backend Environment Configuration
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================

# ---- Application -------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3009","http://localhost:5173"]

# ---- DATA MODE (Section 29/37) ------------------------------
# live       -> real GPS telemetry + configured external traffic provider
# simulation -> SUMO / deterministic generator (labelled SIMULATION)
# test       -> deterministic fixtures (never a live fallback)
DATA_MODE=live

# ---- Database (PostgreSQL / Supabase) -----------------------
# Local dev:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qflow_db
# Supabase pooled example:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ---- Supabase (optional; enables demo scenario + REST fallbacks)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Redis (optional; rate limiting / cache) ----------------
REDIS_URL=redis://localhost:6379/0

# ---- Telemetry security ------------------------------------
# Shared secret Android/GPS devices send as: Authorization: Bearer <secret>
# REQUIRED in production (ingestion refuses unauthenticated posts otherwise).
GPS_AUTH_SECRET=change-me-long-random-string
TELEMETRY_RATE_LIMIT_PER_MIN=240
TELEMETRY_MAX_SPEED_KMH=160
TELEMETRY_MAX_JUMP_SPEED_KMH=250

# ---- Vehicle staleness ladder (seconds) --------------------
STALE_LIVE_S=10
STALE_DEGRADED_S=30
STALE_STALE_S=120
STALE_OFFLINE_S=300

# ---- Map matching ------------------------------------------
MAP_MATCH_SEARCH_RADIUS_M=35
MAP_MATCH_MIN_CONFIDENCE=0.15

# ---- Traffic engine ----------------------------------------
TRAFFIC_MIN_SAMPLES=3
TRAFFIC_OBSERVATION_TTL_S=300
TRAFFIC_MIN_SPEED_KMH=5
TRAFFIC_OUTLIER_STD_DEVS=2.5
TRAFFIC_ENGINE_INTERVAL_S=10

# ---- External traffic provider: none | google | mapbox -----
TRAFFIC_PROVIDER=none
TRAFFIC_API_KEY=
TRAFFIC_PROVIDER_CACHE_TTL_S=120
TRAFFIC_PROVIDER_MIN_INTERVAL_S=30

# ---- Incident engine ---------------------------------------
INCIDENT_ANOMALY_SPEED_DROP_RATIO=0.35
INCIDENT_ANOMALY_MIN_VEHICLES=2
INCIDENT_ANOMALY_PERSIST_S=90
INCIDENT_DEFAULT_TTL_S=3600

# ---- Rerouting thresholds (Section 14) ---------------------
REROUTE_MIN_ETA_GAIN_S=120
REROUTE_MIN_IMPROVEMENT_PCT=8
REROUTE_COOLDOWN_S=30

# ---- QPSO optimizer ----------------------------------------
QPSO_POPULATION_SIZE=24
QPSO_ITERATIONS=60
QPSO_BETA=0.75
QPSO_MIN_INTERVAL_S=20
QPSO_ROUTE_CHANGE_PENALTY_S=45
QPSO_INCIDENT_PENALTY_S=600

# ---- SUMO (simulation mode) --------------------------------
SUMO_BINARY=sumo
SUMO_CONFIG_FILE=
SUMO_STEP_LENGTH_S=1.0
SUMO_MAX_VEHICLES=200
SUMO_TELEMETRY_INTERVAL_S=1.0
